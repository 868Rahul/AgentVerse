# Environment variable configuration

# Database configuration
# SQLite URL (relative paths are resolved against the backend/ folder)
DATABASE_URL=sqlite+aiosqlite:///resource/database.db
# MySQL
# DATABASE_URL=mysql+aiomysql://root:root@localhost/agentverse

# Application configuration
DEBUG=True
APP_NAME=AgentVerse
# Print every LangChain step to the console (very noisy)
LANGCHAIN_DEBUG=False

# Google Gemini (default)
GOOGLE_API_KEY=
DEFAULT_MODEL=gemini-3.6-flash

# Gemini free tier resilience
# Models tried in order when the default model is rate limited (429), overloaded (503) or unavailable (404).
# Each model has its own free tier quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Attempts per model (1 = no retry, switch to the next model immediately)
GEMINI_MAX_RETRIES=1
GEMINI_TIMEOUT_SECONDS=60
# Client side throttle for all Gemini calls, 0 disables it
GEMINI_REQUESTS_PER_MINUTE=30
# Calls allowed back to back before the throttle spaces them
GEMINI_BURST_REQUESTS=5
# Ask the next model too when the current one is silent for this many seconds (0 disables)
GEMINI_HEDGE_AFTER_SECONDS=6
# minimal | low | medium | high, empty = model default. minimal is the fastest
GEMINI_THINKING_LEVEL=minimal

# Guardrails
MAX_INPUT_CHARS=4000
MAX_HISTORY_MESSAGES=20
AGENT_RECURSION_LIMIT=12

# OpenAI
#OPENAI_BASE_URL=
#OPENAI_API_KEY=
#DEFAULT_MODEL=gpt-4o-mini

# DashScope
#DASHSCOPE_API_KEY=
#DEFAULT_MODEL=qwen-plus

#DeepSeek
#DEEPSEEK_API_KEY=
#DEFAULT_MODEL=deepseek-chat


# Employee handbook RAG
# google: Gemini embeddings (default, no local service needed) | ollama: local EMBEDDING_MODEL via Ollama
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# Only used with EMBEDDING_PROVIDER=ollama (bge-m3 supports Chinese and English)
EMBEDDING_MODEL=bge-m3
HANDBOOK_PDF_PATH=resource/EmployeeHandbook.pdf

# Relative storage path for ChromaDB
CHROMA_PATH=resource/chroma_db
